.app-shell {
  display: flex;
  width: 100%;
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
  background: #0a0d12;
  color: #eef2f7;
}

.app-shell.light {
  background: #f3f5f8;
  color: #131820;
}

/* =========================
   SIDEBAR
========================= */

.sidebar {
  position: relative;
  z-index: 20;
  display: flex;
  flex-direction: column;
  width: 260px;
  min-width: 260px;
  height: 100vh;
  padding: 18px 14px;
  overflow: hidden;
  background: #0e1218;
  border-right: 1px solid #252b34;
}

.app-shell.light .sidebar {
  background: #ffffff;
  border-right-color: #dde2e8;
}

.brand {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 86px;
  margin-bottom: 16px;
}

.brand-logo {
  display: block;
  width: 156px;
  max-width: 100%;
  height: auto;
  object-fit: contain;
}

.brand-version {
  margin-top: 7px;
  color: #616b79;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

/* La navigation peut défiler indépendamment */
.sidebar-nav {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  padding-right: 3px;
  scrollbar-width: thin;
  scrollbar-color: #2d3541 transparent;
}

.sidebar-nav::-webkit-scrollbar,
.main-content::-webkit-scrollbar {
  width: 7px;
}

.sidebar-nav::-webkit-scrollbar-track,
.main-content::-webkit-scrollbar-track {
  background: transparent;
}

.sidebar-nav::-webkit-scrollbar-thumb,
.main-content::-webkit-scrollbar-thumb {
  border-radius: 999px;
  background: #2c3440;
}

.nav-group-label {
  margin: 2px 10px 9px;
  color: #586271;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.15em;
}

.nav-item {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 43px;
  gap: 11px;
  margin-bottom: 5px;
  padding: 9px 11px;
  border: 1px solid transparent;
  border-radius: 10px;
  background: transparent;
  color: #8f99a8;
  text-align: left;
  cursor: pointer;
  transition:
    background 0.18s ease,
    border-color 0.18s ease,
    color 0.18s ease,
    transform 0.18s ease;
}

.nav-item:hover {
  background: #151a22;
  color: #edf1f6;
}

.nav-item.active {
  background: #1a2029;
  border-color: #2a323d;
  color: #ffffff;
  box-shadow: inset 2px 0 0 #d7dde5;
}

.app-shell.light .nav-item {
  color: #667180;
}

.app-shell.light .nav-item:hover {
  background: #f2f4f7;
  color: #161b22;
}

.app-shell.light .nav-item.active {
  background: #edf0f4;
  border-color: #dde2e8;
  color: #10151b;
  box-shadow: inset 2px 0 0 #28313c;
}

.nav-icon {
  display: grid;
  flex: 0 0 auto;
  width: 27px;
  height: 27px;
  place-items: center;
  border-radius: 8px;
  background: #171c24;
  color: #758091;
  font-size: 13px;
}

.nav-item.active .nav-icon {
  background: #242b36;
  color: #ffffff;
}

.app-shell.light .nav-icon {
  background: #f1f3f6;
  color: #667180;
}

.app-shell.light .nav-item.active .nav-icon {
  background: #ffffff;
  color: #141a22;
}

/* =========================
   SIDEBAR BOTTOM
========================= */

.sidebar-bottom {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 9px;
  padding-top: 12px;
}

.system-status {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 10px;
  border: 1px solid #252c36;
  border-radius: 10px;
  background: #11161d;
}

.app-shell.light .system-status {
  border-color: #dde2e8;
  background: #f8f9fb;
}

.system-status div {
  display: flex;
  flex-direction: column;
  min-width: 0;
  gap: 2px;
}

.system-status strong {
  color: #cbd2dc;
  font-size: 10px;
}

.app-shell.light .system-status strong {
  color: #485362;
}

.system-status span:last-child {
  color: #687282;
  font-size: 9px;
}

.status-dot {
  width: 7px;
  height: 7px;
  flex: 0 0 auto;
  border-radius: 999px;
  background: #48d597;
  box-shadow: 0 0 0 4px rgba(72, 213, 151, 0.08);
}

.logout-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 40px;
  gap: 8px;
  padding: 9px 12px;
  border: 1px solid #2a303a;
  border-radius: 9px;
  background: transparent;
  color: #929cab;
  cursor: pointer;
  transition:
    background 0.18s ease,
    color 0.18s ease,
    border-color 0.18s ease;
}

.logout-button:hover {
  background: #171c24;
  border-color: #343c48;
  color: #ffffff;
}

.app-shell.light .logout-button {
  border-color: #dde2e8;
  color: #697381;
}

.app-shell.light .logout-button:hover {
  background: #f1f3f6;
  border-color: #cfd5dc;
  color: #151a20;
}

/* =========================
   MAIN CONTENT
========================= */

/* Partie droite indépendante */
.main-content {
  flex: 1 1 auto;
  width: calc(100% - 260px);
  min-width: 0;
  height: 100vh;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 28px 30px 40px;
  scroll-behavior: smooth;
  scrollbar-width: thin;
  scrollbar-color: #2c3440 transparent;
}

.app-shell.light .main-content {
  scrollbar-color: #cbd1d9 transparent;
}

/* =========================
   TOPBAR
========================= */

.topbar {
  position: sticky;
  top: -28px;
  z-index: 10;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  padding: 28px 0 22px;
  margin-bottom: 2px;
  background: linear-gradient(
    to bottom,
    #0a0d12 72%,
    rgba(10, 13, 18, 0)
  );
}

.app-shell.light .topbar {
  background: linear-gradient(
    to bottom,
    #f3f5f8 72%,
    rgba(243, 245, 248, 0)
  );
}

.eyebrow {
  margin: 0 0 7px;
  color: #657080;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.topbar h1 {
  margin: 0;
  color: #f8fafc;
  font-size: 32px;
  line-height: 1.05;
  letter-spacing: -0.035em;
}

.app-shell.light .topbar h1 {
  color: #11161d;
}

.subtitle {
  margin: 8px 0 0;
  color: #7f8998;
  font-size: 13px;
}

.profile-badge {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 0 0 auto;
  padding: 8px 11px;
  border: 1px solid #252c35;
  border-radius: 12px;
  background: #11161d;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
}

.app-shell.light .profile-badge {
  border-color: #dde2e8;
  background: #ffffff;
  box-shadow: 0 7px 24px rgba(19, 30, 45, 0.06);
}

.profile-avatar {
  display: grid;
  width: 38px;
  height: 38px;
  place-items: center;
  border-radius: 10px;
  background: #232b37;
  color: #ffffff;
  font-size: 10px;
  font-weight: 800;
}

.app-shell.light .profile-avatar {
  background: #1b222c;
}

.profile-badge div {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.profile-badge strong {
  color: #f2f5f8;
  font-size: 12px;
}

.app-shell.light .profile-badge strong {
  color: #151a21;
}

.profile-badge div span {
  color: #6f7987;
  font-size: 10px;
}

/* =========================
   HERO
========================= */

.hero-card,
.module-hero {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  overflow: hidden;
  border: 1px solid #262d38;
  border-radius: 18px;
  background:
    radial-gradient(
      circle at 86% 20%,
      rgba(255, 255, 255, 0.075),
      transparent 26%
    ),
    linear-gradient(135deg, #151a22 0%, #10141b 100%);
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.16);
}

.hero-card::after,
.module-hero::after {
  content: "";
  position: absolute;
  width: 240px;
  height: 240px;
  right: -110px;
  top: -120px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.04);
}

.app-shell.light .hero-card,
.app-shell.light .module-hero {
  border-color: #dfe4ea;
  background:
    radial-gradient(
      circle at 86% 20%,
      rgba(15, 23, 42, 0.04),
      transparent 26%
    ),
    linear-gradient(135deg, #ffffff 0%, #f7f9fb 100%);
  box-shadow: 0 18px 45px rgba(20, 31, 48, 0.07);
}

.hero-card {
  min-height: 235px;
  margin-bottom: 18px;
  padding: 32px;
}

.hero-label {
  display: inline-block;
  margin-bottom: 12px;
  color: #aeb7c4;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.18em;
}

.app-shell.light .hero-label {
  color: #667180;
}

.hero-card h2,
.module-hero h2 {
  position: relative;
  z-index: 1;
  max-width: 770px;
  margin: 0;
  color: #f8fafc;
  font-size: clamp(29px, 3.4vw, 46px);
  line-height: 1.06;
  letter-spacing: -0.045em;
}

.app-shell.light .hero-card h2,
.app-shell.light .module-hero h2 {
  color: #10161d;
}

.hero-card p,
.module-hero p {
  position: relative;
  z-index: 1;
  max-width: 760px;
  margin: 13px 0 0;
  color: #85909f;
  font-size: 13px;
  line-height: 1.65;
}

.hero-mark,
.module-number {
  position: relative;
  z-index: 1;
  display: grid;
  flex: 0 0 auto;
  width: 112px;
  height: 112px;
  place-items: center;
  border: 1px solid #38414d;
  border-radius: 25px;
  background: #171d26;
  color: #f8fafc;
  font-size: 50px;
  font-weight: 800;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.03),
    0 16px 35px rgba(0, 0, 0, 0.14);
}

.app-shell.light .hero-mark,
.app-shell.light .module-number {
  border-color: #d4dae1;
  background: #eef1f5;
  color: #11161d;
  box-shadow: 0 15px 28px rgba(29, 39, 54, 0.06);
}

/* =========================
   KPI CARDS
========================= */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 18px;
}

.stat-card {
  position: relative;
  overflow: hidden;
  padding: 17px 18px;
  border: 1px solid #252c36;
  border-radius: 13px;
  background: #10151c;
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
}

.stat-card::after {
  content: "";
  position: absolute;
  inset: auto 16px 0;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.08),
    transparent
  );
}

.app-shell.light .stat-card {
  border-color: #dde2e8;
  background: #ffffff;
  box-shadow: 0 7px 25px rgba(19, 30, 45, 0.055);
}

.stat-card span {
  display: block;
  color: #7e8998;
  font-size: 11px;
}

.stat-card strong {
  display: block;
  margin: 8px 0 5px;
  color: #f4f7fa;
  font-size: 26px;
  line-height: 1;
  letter-spacing: -0.025em;
}

.app-shell.light .stat-card strong {
  color: #11161d;
}

.stat-card small {
  color: #626d7c;
  font-size: 10px;
}

/* =========================
   GRAPHS
========================= */

.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.7fr) minmax(310px, 1fr);
  gap: 13px;
  margin-bottom: 18px;
}

.panel {
  min-width: 0;
  border: 1px solid #252c36;
  border-radius: 14px;
  background: #10151c;
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
}

.app-shell.light .panel {
  border-color: #dde2e8;
  background: #ffffff;
  box-shadow: 0 7px 25px rgba(19, 30, 45, 0.055);
}

.panel-large {
  min-height: 350px;
}

.panel-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
  padding: 18px 18px 0;
}

.panel-heading h2 {
  margin: 0;
  color: #f4f7fa;
  font-size: 18px;
  line-height: 1.15;
  letter-spacing: -0.02em;
}

.app-shell.light .panel-heading h2 {
  color: #11161d;
}

.period-badge {
  flex: 0 0 auto;
  padding: 5px 8px;
  border: 1px solid #2b333f;
  border-radius: 7px;
  background: #141a22;
  color: #75808f;
  font-size: 9px;
  font-weight: 700;
}

.app-shell.light .period-badge {
  border-color: #dce1e7;
  background: #f6f7f9;
}

/* =========================
   LINE CHART
========================= */

.chart-wrap {
  position: relative;
  min-height: 275px;
  padding: 9px 13px 8px;
}

.line-chart {
  display: block;
  width: 100%;
  height: 260px;
}

.chart-grid-line {
  stroke: #222934;
  stroke-width: 1;
  stroke-dasharray: 4 6;
}

.app-shell.light .chart-grid-line {
  stroke: #e6e9ed;
}

.chart-line {
  stroke: #87919e;
  stroke-width: 2.6;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-dasharray: 6 5;
}

.app-shell.light .chart-line {
  stroke: #6e7886;
}

.chart-point {
  fill: #11161d;
  stroke: #9aa4b1;
  stroke-width: 2;
}

.app-shell.light .chart-point {
  fill: #ffffff;
  stroke: #697483;
}

.chart-label {
  fill: #5f6a79;
  font-size: 10px;
}

.chart-empty {
  position: absolute;
  top: 105px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  width: min(90%, 350px);
  flex-direction: column;
  align-items: center;
  gap: 5px;
  padding: 11px 14px;
  border: 1px solid rgba(255, 255, 255, 0.04);
  border-radius: 10px;
  background: rgba(15, 19, 25, 0.76);
  text-align: center;
  backdrop-filter: blur(8px);
}

.app-shell.light .chart-empty {
  border-color: #eef0f3;
  background: rgba(255, 255, 255, 0.88);
}

.chart-empty strong {
  color: #a7b0bc;
  font-size: 11px;
}

.app-shell.light .chart-empty strong {
  color: #5d6775;
}

.chart-empty span {
  color: #626d7b;
  font-size: 9px;
  line-height: 1.5;
}

.chart-empty.compact {
  position: static;
  width: auto;
  margin: 12px 16px 0;
  transform: none;
  backdrop-filter: none;
}

/* =========================
   BAR CHART
========================= */

.bar-chart {
  min-height: 275px;
  padding: 12px 18px 16px;
}

.bar-chart-area {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  align-items: end;
  gap: 12px;
  height: 205px;
  padding: 0 2px;
}

.bar-column {
  display: flex;
  min-width: 0;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: end;
  gap: 6px;
  color: #697484;
  font-size: 9px;
}

.bar-value {
  color: #7d8795;
  font-size: 9px;
}

.bar-track {
  display: flex;
  align-items: flex-end;
  width: 100%;
  max-width: 48px;
  height: 150px;
  overflow: hidden;
  border-radius: 8px 8px 5px 5px;
  background: #1a2028;
}

.app-shell.light .bar-track {
  background: #eef1f4;
}

.bar-fill {
  width: 100%;
  height: 0;
  border-radius: 8px 8px 5px 5px;
  background: linear-gradient(to top, #6c7684, #9da6b1);
}

/* =========================
   PÔLES
========================= */

.section-block {
  padding-bottom: 28px;
}

.section-heading {
  margin-bottom: 11px;
}

.section-heading h2 {
  margin: 0;
  color: #f4f7fa;
  font-size: 20px;
  line-height: 1.2;
  letter-spacing: -0.025em;
}

.app-shell.light .section-heading h2 {
  color: #11161d;
}

.poles-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 13px;
}

.pole-card {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 100px;
  gap: 13px;
  padding: 15px;
  border: 1px solid #252c36;
  border-radius: 13px;
  background: #10151c;
  text-align: left;
  cursor: pointer;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.07);
  transition:
    transform 0.18s ease,
    border-color 0.18s ease,
    background 0.18s ease;
}

.app-shell.light .pole-card {
  border-color: #dde2e8;
  background: #ffffff;
  box-shadow: 0 7px 23px rgba(19, 30, 45, 0.045);
}

.pole-card:hover {
  transform: translateY(-2px);
  border-color: #37404d;
  background: #141922;
}

.app-shell.light .pole-card:hover {
  border-color: #cfd6de;
  background: #fafbfc;
}

.pole-icon {
  display: grid;
  flex: 0 0 auto;
  width: 51px;
  height: 51px;
  place-items: center;
  border: 1px solid #303844;
  border-radius: 13px;
  background: #171d25;
  color: #f3f6f9;
  font-size: 18px;
  font-weight: 800;
}

.app-shell.light .pole-icon {
  border-color: #dfe4e9;
  background: #f1f3f6;
  color: #11161d;
}

.pole-content {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4px;
}

.pole-content strong {
  color: #f2f5f8;
  font-size: 14px;
}

.app-shell.light .pole-content strong {
  color: #11161d;
}

.pole-content span {
  color: #768191;
  font-size: 11px;
  line-height: 1.45;
}

.arrow {
  flex: 0 0 auto;
  color: #687383;
  font-size: 18px;
}

/* =========================
   MODULES
========================= */

.module-page {
  min-width: 0;
}

.module-hero {
  min-height: 185px;
  margin-bottom: 18px;
  padding: 28px 30px;
}

.module-hero h2 {
  font-size: 31px;
}

.module-number {
  width: 88px;
  height: 88px;
  border-radius: 20px;
  font-size: 33px;
}

.finance-stats {
  margin-bottom: 18px;
}

.transactions-panel {
  margin-bottom: 20px;
}

.empty-table {
  display: flex;
  min-height: 190px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin: 16px;
  border: 1px dashed #2b333e;
  border-radius: 11px;
  background: #0e1218;
  text-align: center;
}

.app-shell.light .empty-table {
  border-color: #dce2e8;
  background: #fafbfc;
}

.empty-table strong {
  color: #a9b2be;
  font-size: 12px;
}

.app-shell.light .empty-table strong {
  color: #525d6b;
}

.empty-table span {
  color: #626d7c;
  font-size: 10px;
}

/* =========================
   PARAMÈTRES
========================= */

.settings-page {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding-bottom: 25px;
}

.settings-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 13px;
}

.settings-form {
  display: flex;
  flex-direction: column;
  gap: 13px;
  padding: 0 18px 18px;
}

.settings-form label {
  display: flex;
  flex-direction: column;
  gap: 6px;
  color: #7f8997;
  font-size: 10px;
}

.app-shell.light .settings-form label {
  color: #697381;
}

.settings-form input {
  width: 100%;
  padding: 11px 12px;
  border: 1px solid #2a323d;
  border-radius: 9px;
  outline: none;
  background: #0c1015;
  color: #f5f7fa;
  transition: border-color 0.18s ease;
}

.settings-form input:focus {
  border-color: #566170;
}

.app-shell.light .settings-form input {
  border-color: #dce2e8;
  background: #ffffff;
  color: #11161d;
}

.primary-button {
  min-height: 40px;
  margin-top: 2px;
  padding: 10px 13px;
  border: 0;
  border-radius: 9px;
  background: #e8edf2;
  color: #10151b;
  font-size: 11px;
  font-weight: 800;
  cursor: pointer;
  transition:
    transform 0.18s ease,
    background 0.18s ease;
}

.primary-button:hover {
  transform: translateY(-1px);
  background: #ffffff;
}

.app-shell.light .primary-button {
  background: #151b22;
  color: #ffffff;
}

.app-shell.light .primary-button:hover {
  background: #242c35;
}

.settings-message {
  padding: 9px 10px;
  border: 1px solid #2b333d;
  border-radius: 8px;
  background: #141920;
  color: #909aa8;
  font-size: 10px;
}

.app-shell.light .settings-message {
  border-color: #dde2e8;
  background: #f7f8fa;
  color: #5e6876;
}

.theme-options {
  display: flex;
  flex-direction: column;
  gap: 9px;
  padding: 0 18px 18px;
}

.theme-option {
  display: flex;
  align-items: center;
  width: 100%;
  gap: 11px;
  padding: 11px;
  border: 1px solid #292f39;
  border-radius: 10px;
  background: #10151c;
  color: #ffffff;
  text-align: left;
  cursor: pointer;
}

.app-shell.light .theme-option {
  border-color: #dde2e8;
  background: #ffffff;
  color: #11161d;
}

.theme-option.selected {
  border-color: #596473;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.03);
}

.theme-option > span:last-child {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.theme-option strong {
  font-size: 11px;
}

.theme-option small {
  color: #707a89;
  font-size: 9px;
}

.theme-preview {
  width: 50px;
  height: 34px;
  flex: 0 0 auto;
  border: 1px solid #323945;
  border-radius: 7px;
}

.dark-preview {
  background: linear-gradient(135deg, #0b0f14, #252c36);
}

.light-preview {
  background: linear-gradient(135deg, #ffffff, #e8ecf1);
}

.settings-info {
  padding: 18px;
}

.settings-info h2 {
  margin: 0 0 7px;
  color: #f2f5f8;
  font-size: 18px;
}

.app-shell.light .settings-info h2 {
  color: #11161d;
}

.settings-info > p:last-child {
  max-width: 760px;
  margin: 0;
  color: #778190;
  font-size: 11px;
  line-height: 1.65;
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 1180px) {
  .sidebar {
    width: 230px;
    min-width: 230px;
  }

  .main-content {
    width: calc(100% - 230px);
    padding: 24px;
  }

  .topbar {
    top: -24px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .dashboard-grid {
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 1fr);
  }
}

@media (max-width: 900px) {
  .app-shell {
    height: auto;
    min-height: 100vh;
    overflow: visible;
  }

  .sidebar {
    position: static;
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: auto;
    overflow: visible;
    border-right: 0;
    border-bottom: 1px solid #252b34;
  }

  .app-shell.light .sidebar {
    border-bottom-color: #dde2e8;
  }

  .sidebar-nav {
    overflow: visible;
  }

  .sidebar-bottom {
    margin-top: 8px;
  }

  .main-content {
    width: 100%;
    height: auto;
    min-height: auto;
    overflow: visible;
    padding: 22px;
  }

  .topbar {
    position: static;
    padding: 0 0 20px;
    background: transparent;
  }

  .dashboard-grid,
  .settings-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 650px) {
  .main-content {
    padding: 16px;
  }

  .stats-grid,
  .poles-grid {
    grid-template-columns: 1fr;
  }

  .topbar {
    flex-direction: column;
  }

  .profile-badge {
    width: 100%;
  }

  .hero-card,
  .module-hero {
    padding: 22px;
  }

  .hero-mark,
  .module-number {
    display: none;
  }

  .hero-card h2 {
    font-size: 29px;
  }
}